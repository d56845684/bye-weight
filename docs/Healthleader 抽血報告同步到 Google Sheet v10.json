      "id": "413f175c-0900-44b8-8c1e-29fefdbaf340",
      "name": "8.5 Read Existing Reports",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        34336,
        6736
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "H03DTZFclAXelmuf",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 去重：比對 Node 8 解析結果與已存在的抽血報告\nconst newItems = $('8. Parse Lab Results (SVG)').all();\nconst existingItems = $input.all();\n\nconst existingKeys = new Set();\nfor (const item of existingItems) {\n  const name = String(item.json['姓名'] || '').trim();\n  const date = String(item.json['檢驗日期'] || '').trim();\n  if (name && date) existingKeys.add(name + '|' + date);\n}\n\nconst results = [];\nfor (const item of newItems) {\n  const name = String(item.json['姓名'] || '').trim();\n  const date = String(item.json['檢驗日期'] || '').trim();\n  const key = name + '|' + date;\n  if (!existingKeys.has(key)) {\n    results.push(item);\n  }\n}\n\nreturn results;"
      },
